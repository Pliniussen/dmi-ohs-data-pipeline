{
    "name": "Python Development Container",

    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },

    "workspaceFolder": "/workspaces/dmi-ohs-data-pipeline",

    // Non-root user; Dev Containers matches its UID to the host user, so files
    // saved in the container stay owned by you in WSL.
    "remoteUser": "vscode",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python"
            }
        }
    }
}